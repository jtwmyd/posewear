[Unit]
Description=PoseWear HTTP self-host (does not bind or modify port 443)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=posewear
Group=posewear
WorkingDirectory=__PREFIX__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=POSEWEAR_ROOT=__PREFIX__/dist
Environment=POSEWEAR_STATE=/var/lib/posewear
Environment=POSEWEAR_ACME_WEBROOT=/var/lib/posewear/acme-webroot
Environment=POSEWEAR_HOST=0.0.0.0
Environment=POSEWEAR_PORT=__PORT__
Environment=POSEWEAR_TLS_PORT=8443
Environment=POSEWEAR_TLS_CERT=/var/lib/posewear/tls/fullchain.pem
Environment=POSEWEAR_TLS_KEY=/var/lib/posewear/tls/privkey.pem
Environment=POSEWEAR_TLS_ORIGIN=https://176.122.145.34:8443
Environment=POSEWEAR_PUBLIC_ORIGIN=https://176.122.145.34:8443
ExecStart=/usr/bin/python3 __PREFIX__/serve.py
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=__PREFIX__
ReadWritePaths=/var/lib/posewear
StateDirectory=posewear
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
